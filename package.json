{
  "name": "personnal-agents",
  "version": "1.0.0",
  "description": "Looma - Local-first client follow-through companion",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "start": "cross-env NODE_ENV=production electron .",
    "build": "node scripts/build-info.cjs && tsc && vite build && node scripts/build-info.cjs --stamp-dist",
    "package:trial": "npm run build && node scripts/package-trial.cjs",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "test:native": "node scripts/test-native.cjs",
    "prepare:sqlite": "node scripts/prepare-sqlite.cjs",
    "postinstall": "node scripts/prepare-sqlite.cjs"
  },
  "keywords": [
    "personal-agent",
    "companion",
    "ambient-ai",
    "electron",
    "react",
    "artifacts"
  ],
  "author": "Ambi Team",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
